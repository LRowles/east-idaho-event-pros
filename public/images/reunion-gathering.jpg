			<script>
				( () => {
					const lazyloadRunObserver = () => {
						const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
						const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
							entries.forEach( ( entry ) => {
								if ( entry.isIntersecting ) {
									let lazyloadBackground = entry.target;
									if( lazyloadBackground ) {
										lazyloadBackground.classList.add( 'e-lazyloaded' );
									}
									lazyloadBackgroundObserver.unobserve( entry.target );
								}
							});
						}, { rootMargin: '200px 0px 200px 0px' } );
						lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
							lazyloadBackgroundObserver.observe( lazyloadBackground );
						} );
					};
					const events = [
						'DOMContentLoaded',
						'elementor/lazyload/observe',
					];
					events.forEach( ( event ) => {
						document.addEventListener( event, lazyloadRunObserver );
					} );
				} )();
			</script>
			<style>
.sdm-featured-events {
  padding: 80px 20px;
  background: linear-gradient(135deg, #faf6f1 0%, #f5ede3 50%, #faf6f1 100%);
  position: relative;
  overflow: hidden;
}
.sdm-featured-events::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at 20% 50%, rgba(139, 69, 19, 0.04) 0%, transparent 50%),
              radial-gradient(ellipse at 80% 50%, rgba(101, 67, 33, 0.04) 0%, transparent 50%);
  pointer-events: none;
}
.sdm-featured-events .sdm-section-header {
  text-align: center;
  margin-bottom: 50px;
  position: relative;
  z-index: 1;
}
.sdm-featured-events .sdm-section-header h2 {
  font-family: 'Playfair Display', serif;
  font-size: 2.8rem;
  color: #3d2117;
  margin-bottom: 15px;
  font-weight: 700;
}
.sdm-featured-events .sdm-section-header .sdm-divider {
  width: 60px;
  height: 3px;
  background: #8B4513;
  margin: 0 auto 20px;
  border-radius: 2px;
}
.sdm-featured-events .sdm-section-header p {
  color: #5a3e2b;
  font-size: 1.1rem;
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.6;
}
.sdm-events-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  position: relative;
  z-index: 1;
}
.sdm-event-card {
  background: #ffffff;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid rgba(139, 69, 19, 0.12);
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
}
.sdm-event-card:hover {
  transform: translateY(-8px);
  border-color: rgba(139, 69, 19, 0.25);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
}
.sdm-event-card .sdm-card-image {
  position: relative;
  height: 220px;
  overflow: hidden;
}
.sdm-event-card .sdm-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.sdm-event-card:hover .sdm-card-image img {
  transform: scale(1.05);
}
.sdm-event-card .sdm-card-badge {
  position: absolute;
  top: 15px;
  left: 15px;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #fff;
  background: #8B4513;
  z-index: 2;
}
.sdm-event-card .sdm-card-content {
  padding: 25px;
}
.sdm-event-card .sdm-card-content h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.3rem;
  color: #3d2117;
  margin-bottom: 8px;
  font-weight: 600;
}
.sdm-event-card .sdm-card-venue {
  color: #8B4513;
  font-size: 0.9rem;
  margin-bottom: 12px;
  font-weight: 500;
}
.sdm-event-card .sdm-card-desc {
  color: #5a3e2b;
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 18px;
}
.sdm-event-card .sdm-card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 15px;
  border-top: 1px solid rgba(139, 69, 19, 0.1);
}
.sdm-event-card .sdm-card-date {
  color: #7a6252;
  font-size: 0.85rem;
}
.sdm-event-card .sdm-card-guests {
  background: rgba(139, 69, 19, 0.1);
  color: #8B4513;
  padding: 4px 12px;
  border-radius: 12px;
  font-size: 0.8rem;
  font-weight: 600;
}
.sdm-events-cta {
  text-align: center;
  margin-top: 50px;
  position: relative;
  z-index: 1;
}
.sdm-events-cta a {
  display: inline-block;
  padding: 16px 40px;
  background: #8B4513;
  color: #fff !important;
  text-decoration: none;
  border-radius: 8px;
  font-weight: 700;
  font-size: 1rem;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(139, 69, 19, 0.3);
}
.sdm-events-cta a:hover {
  background: #6d3610;
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(139, 69, 19, 0.4);
}
.sdm-events-cta p {
  color: #7a6252;
  margin-top: 15px;
  font-size: 0.95rem;
}
@media (max-width: 768px) {
  .sdm-events-grid { grid-template-columns: 1fr; gap: 20px; }
  .sdm-featured-events .sdm-section-header h2 { font-size: 2rem; }
  .sdm-featured-events { padding: 50px 15px; }
}
</style>

<section class="sdm-featured-events" id="sdm-featured-events">
  <div class="sdm-section-header">
    <h2>Recent Events We've Catered</h2>
    <div class="sdm-divider"></div>
    <p>From intimate celebrations to grand receptions &mdash; here's a look at some of our recent work across Eastern Idaho.</p>
  </div>
  <div class="sdm-events-grid">
    <div class="sdm-event-card">
      <div class="sdm-card-image">
        <img src="https://simplydeliciousmeals4you.com/wp-content/uploads/2021/10/wedding-resized.jpg" alt="Wedding reception catering at The Waterfront Idaho Falls" loading="lazy">
        <span class="sdm-card-badge">Wedding</span>
      </div>
      <div class="sdm-card-content">
        <h3>Spring Garden Wedding Reception</h3>
        <div class="sdm-card-venue">📍 The Waterfront, Idaho Falls</div>
        <p class="sdm-card-desc">An elegant riverside reception featuring our signature charcuterie display, herb-crusted prime rib, and a custom dessert bar with miniature pastries.</p>
        <div class="sdm-card-meta">
          <span class="sdm-card-date">Spring 2025</span>
          <span class="sdm-card-guests">200+ Guests</span>
        </div>
      </div>
    </div>
    <div class="sdm-event-card">
      <div class="sdm-card-image">
        <img src="https://simplydeliciousmeals4you.com/wp-content/uploads/2026/04/BestBBQ.jpg" alt="Corporate BBQ catering at Westbank Events Center" loading="lazy">
        <span class="sdm-card-badge">Corporate</span>
      </div>
      <div class="sdm-card-content">
        <h3>Annual Company BBQ Celebration</h3>
        <div class="sdm-card-venue">📍 Westbank Events Center, Idaho Falls</div>
        <p class="sdm-card-desc">A full smokehouse spread with 12-hour brisket, pulled pork sliders, smoked tri-tip, and all the classic sides for a company appreciation event.</p>
        <div class="sdm-card-meta">
          <span class="sdm-card-date">Summer 2025</span>
          <span class="sdm-card-guests">150 Guests</span>
        </div>
      </div>
    </div>
    <div class="sdm-event-card">
      <div class="sdm-card-image">
        <img src="https://simplydeliciousmeals4you.com/wp-content/uploads/2026/04/Desserts.jpg" alt="Celebration catering at LaBelle Lake Rigby" loading="lazy">
        <span class="sdm-card-badge">Celebration</span>
      </div>
      <div class="sdm-card-content">
        <h3>Graduation Party & Family Reunion</h3>
        <div class="sdm-card-venue">📍 LaBelle Lake, Rigby</div>
        <p class="sdm-card-desc">A lakeside celebration combining graduation festivities with a family reunion &mdash; featuring our crowd-favorite taco bar and fresh fruit medley.</p>
        <div class="sdm-card-meta">
          <span class="sdm-card-date">Spring 2025</span>
          <span class="sdm-card-guests">120 Guests</span>
        </div>
      </div>
    </div>
  </div>
  <div class="sdm-events-cta">
    <a href="/contact/">BOOK YOUR EVENT TODAY</a>
    <p>Join hundreds of satisfied clients across Eastern Idaho</p>
  </div>
</section>

<script>
(function() {
  if (!document.body.classList.contains('home') && !document.body.classList.contains('page-id-2')) return;
  var section = document.getElementById('sdm-featured-events');
  if (!section) return;
  var testimonials = document.querySelector('.elementor-widget-testimonial, .elementor-element [data-widget_type="testimonial.default"]');
  if (!testimonials) {
    var headings = document.querySelectorAll('h2');
    headings.forEach(function(h) {
      if (h.textContent.includes('What Our Clients Say')) {
        testimonials = h.closest('.elementor-section') || h.closest('section') || h.parentElement;
      }
    });
  }
  if (testimonials) {
    testimonials.parentNode.insertBefore(section, testimonials.nextSibling);
  }
})();
</script><script>/* ===== CLICKABLE SERVICE CARDS ON HOMEPAGE ===== */
document.addEventListener('DOMContentLoaded', function() {
    if (window.location.pathname !== '/' && window.location.pathname !== '/home/' && window.location.pathname !== '/home') return;
    
    var serviceLinks = {
        'Weddings': '/wedding-catering/',
        'Corporate Events': '/corporate-event-catering/',
        'BBQ & Smokehouse': '/bbq-smokehouse-catering/',
        'Social Gatherings': '/social-gathering-catering/'
    };
    
    var iconBoxes = document.querySelectorAll('.elementor-widget-icon-box');
    
    iconBoxes.forEach(function(box) {
        var titleEl = box.querySelector('.elementor-icon-box-title');
        if (!titleEl) return;
        
        var titleText = titleEl.textContent.trim();
        var link = serviceLinks[titleText];
        
        if (link) {
            box.style.cursor = 'pointer';
            box.setAttribute('role', 'link');
            box.setAttribute('aria-label', 'Learn more about ' + titleText);
            
            box.addEventListener('click', function(e) {
                e.preventDefault();
                window.location.href = link;
            });
            
            if (!titleEl.querySelector('a')) {
                var anchor = document.createElement('a');
                anchor.href = link;
                anchor.style.color = 'inherit';
                anchor.style.textDecoration = 'none';
                anchor.innerHTML = titleEl.innerHTML;
                titleEl.innerHTML = '';
                titleEl.appendChild(anchor);
            }
        }
    });
});

/* ===== FOOTER LOGO SWAP ===== */
document.addEventListener('DOMContentLoaded', function() {
    // Find the old footer logo and swap it with the new one
    var footerImgs = document.querySelectorAll('.footer-inner .footer-col img, .site-footer img');
    footerImgs.forEach(function(img) {
        if (img.src && (img.src.indexOf('logo-header-retina') !== -1 || img.src.indexOf('logo-header') !== -1)) {
            img.src = 'https://simplydeliciousmeals4you.com/wp-content/uploads/2026/04/logo_transparent.png';
            img.alt = 'Simply Delicious Catering & BBQ';
            img.style.maxWidth = '200px';
            img.style.height = 'auto';
            img.style.objectFit = 'contain';
        }
    });
    
    // Also handle the Astra custom logo in footer - it's too large
    var customLogos = document.querySelectorAll('.site-footer .custom-logo');
    customLogos.forEach(function(logo) {
        logo.style.maxWidth = '180px';
        logo.style.height = 'auto';
    });
});
</script><script id="astra-theme-js-js-extra">
