}

.ast-site-identity .site-logo-img img {
    max-width: 180px !important;
    max-height: 70px !important;
    width: auto !important;
    height: auto !important;
}

/* Fix header alignment */
.ast-primary-header-bar .site-primary-header-wrap {
    padding-top: 8px !important;
    padding-bottom: 8px !important;
}

/* Service Areas page - make city links clickable */
.service-areas-grid a,
.entry-content a[href*="service-areas/"] {
    color: var(--sdm-primary) !important;
    text-decoration: none !important;
    transition: color 0.2s ease !important;
}
.entry-content a[href*="service-areas/"]:hover {
    color: var(--sdm-secondary) !important;
}


/* ===== LOVABLE-INSPIRED DESIGN UPDATES ===== */

/* 1. FIX LOGO - Remove black background */
.site-logo-img img,
.custom-logo,
.ast-site-identity img,
.site-header .custom-logo-link img {
    background: transparent !important;
    background-color: transparent !important;
    padding: 5px !important;
    border-radius: 0 !important;
    box-shadow: none !important;
}

/* 2. SERVICE AREA PAGES - Remove black border */
.page-template-default .entry-content > div[style*="border"],
.page-template-default .entry-content > div:first-child,
.single-page .entry-content > div,
.ast-article-single .entry-content > div[style*="border"],
body.page .entry-content > div {
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
}

/* 3. Remove ALL green from the site */
.entry-content h2,
.entry-content h3,
.entry-content h4,
.ast-article-single h2,
.ast-article-single h3 {
    color: var(--sdm-primary, #4A2040);
    font-family: 'Playfair Display', serif !important;
    font-style: normal !important;
}

/* 4. Replace green CTA buttons with warm gold */
.entry-content a[style*="background"],
.entry-content a[href*="contact"],
.wp-block-button__link,
a.sdm-cta-btn,
.entry-content a[style*="green"],
.entry-content a[style*="#4CAF50"],
.entry-content a[style*="#28a745"],
.entry-content a[style*="#27ae60"] {
    background: var(--sdm-secondary, #C8963E) !important;
    background-color: var(--sdm-secondary, #C8963E) !important;
    color: #fff !important;
    border: none !important;
    border-radius: 6px !important;
    padding: 14px 32px !important;
    font-family: 'Inter', sans-serif !important;
    font-weight: 600 !important;
    font-size: 15px !important;
    letter-spacing: 0.5px !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    display: inline-block !important;
    transition: all 0.3s ease !important;
}
.entry-content a[style*="background"]:hover,
.entry-content a[href*="contact"]:hover,
.wp-block-button__link:hover {
    background: #b8862e !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 4px 15px rgba(200, 150, 62, 0.3) !important;
}

/* 5. Service Area Page - Better Design */
body.page-template-default .entry-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Service area page hero-style heading */
body.page-template-default .entry-content h2:first-of-type {
    font-size: 2.2rem !important;
    text-align: center !important;
    padding: 40px 20px 20px !important;
    margin-bottom: 10px !important;
    color: var(--sdm-primary) !important;
}

/* Service area intro paragraph */
body.page-template-default .entry-content > p:first-of-type {
    text-align: center;
    font-size: 1.1rem;
    color: #555;
    max-width: 700px;
    margin: 0 auto 30px;
    line-height: 1.7;
}

/* Service area section headings */
body.page-template-default .entry-content h3 {
    font-size: 1.5rem !important;
    color: var(--sdm-primary) !important;
    border-bottom: 2px solid var(--sdm-secondary) !important;
    padding-bottom: 10px !important;
    margin-top: 40px !important;
    margin-bottom: 20px !important;
    font-style: normal !important;
}

/* Service area lists */
body.page-template-default .entry-content ul {
    list-style: none !important;
    padding-left: 0 !important;
}
body.page-template-default .entry-content ul li {
    padding: 8px 0 8px 28px !important;
    position: relative;
    border-bottom: 1px solid #f0ebe5;
    font-size: 1rem;
    color: #444;
}
body.page-template-default .entry-content ul li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--sdm-secondary);
    font-weight: bold;
    font-size: 1.1rem;
}
body.page-template-default .entry-content ul li strong {
    color: var(--sdm-primary);
}

/* Hide the default page title on service area pages */
body.page-template-default .entry-header .entry-title,
body.page-template-default h1.entry-title {
    display: none !important;
}

/* 6. Overall typography cleanup */
body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
    color: #333 !important;
    line-height: 1.7 !important;
}

h1, h2, h3, h4, h5, h6 {
    font-family: 'Playfair Display', serif !important;
    color: var(--sdm-primary);
    font-style: normal !important;
}

/* 7. Clean card styling for content sections */
.elementor-widget-text-editor,
.elementor-widget-heading {
    font-family: inherit !important;
}

/* 8. Navigation cleanup */
.ast-header-break-point .main-navigation {
    background: #fff !important;
}
.main-navigation a,
.ast-nav-menu a {
    font-family: 'Inter', sans-serif !important;
    font-weight: 500 !important;
    font-size: 14px !important;
    letter-spacing: 0.5px !important;
    color: var(--sdm-charcoal, #2D2D2D) !important;
}
.main-navigation a:hover,
.ast-nav-menu a:hover {
    color: var(--sdm-secondary, #C8963E) !important;
}


/* ===== POPULAR BADGE STYLING ===== */
.sdm-popular-badge {
    display: inline-block;
    background: #f0fdf4;
    color: #16a34a;
    font-size: 11px;
    font-weight: 600;
    font-family: 'Inter', sans-serif;
    padding: 3px 10px;
    border-radius: 20px;
    border: 1px solid #bbf7d0;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    margin-left: 8px;
    vertical-align: middle;
}

/* ===== LOVABLE-STYLE FOOTER ===== */
.site-footer, footer.site-footer, .ast-footer, .site-below-footer-wrap {
    display: none !important;
}

.sdm-custom-footer {
    background: #1a1a2e !important;
    color: #e0e0e0;
    padding: 60px 0 30px;
    font-family: 'Inter', sans-serif;
}

.sdm-custom-footer .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 30px;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 40px;
}

.sdm-custom-footer .footer-col h4 {
    color: #ffffff;
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    margin-bottom: 20px;
    font-weight: 600;
}

.sdm-custom-footer .footer-col p,
.sdm-custom-footer .footer-col a {
    color: #b0b0b0;
    font-size: 14px;
    line-height: 1.8;
    text-decoration: none;
    transition: color 0.2s;
}

.sdm-custom-footer .footer-col a:hover {
    color: var(--sdm-secondary);
}

.sdm-custom-footer .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.sdm-custom-footer .footer-col ul li {
    margin-bottom: 8px;
}

.sdm-custom-footer .footer-logo {
    max-width: 180px;
    margin-bottom: 15px;
    filter: none;
}

.sdm-custom-footer .footer-bottom {
    max-width: 1200px;
    margin: 40px auto 0;
    padding: 20px 30px 0;
    border-top: 1px solid rgba(255,255,255,0.1);
    text-align: center;
    color: #888;
    font-size: 13px;
}

.sdm-custom-footer .footer-contact-item {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
}

.sdm-custom-footer .footer-contact-item svg {
    width: 16px;
    height: 16px;
    fill: var(--sdm-secondary);
    flex-shrink: 0;
}

/* ===== SERVICE AREA PAGES - BETTER DESIGN ===== */
.page-template-default .entry-content h1,
.page-template-default .entry-content h2 {
    font-family: 'Playfair Display', serif !important;
    color: var(--sdm-primary);
    border: none !important;
}

.page-template-default .entry-content h3 {
    font-family: 'Playfair Display', serif !important;
    color: var(--sdm-charcoal) !important;
    border: none !important;
    border-bottom: 2px solid var(--sdm-secondary) !important;
    padding-bottom: 8px !important;
    display: inline-block !important;
}

/* Remove any remaining green from service area pages */
.page-template-default .entry-content a.elementor-button,
.page-template-default .entry-content .wp-block-button__link,
.page-template-default .entry-content a[style*="background-color: #27ae60"],
.page-template-default .entry-content a[style*="background-color:#27ae60"],
.page-template-default .entry-content a[style*="green"] {
    background-color: var(--sdm-secondary) !important;
    border-color: var(--sdm-secondary) !important;
    color: #fff !important;
    border-radius: 6px !important;
}

/* Service area page cards/sections */
.page-template-default .entry-content .wp-block-group,
.page-template-default .entry-content [style*="border"] {
    border: none !important;
    border-radius: var(--sdm-radius) !important;
    box-shadow: var(--sdm-shadow) !important;
}

@media (max-width: 1024px) {
    .sdm-custom-footer .footer-inner {
        grid-template-columns: 1.5fr 1fr;
        gap: 30px;
    }
}

@media (max-width: 768px) {
    .sdm-custom-footer .footer-inner {
        grid-template-columns: 1fr;
        gap: 30px;
    }
}


/* ===== SERVICE AREA PAGES - HERO BANNER ===== */
.page-template-default .entry-content > h2:first-of-type,
.page-template-default .entry-content > h2:first-child {
    background: linear-gradient(135deg, var(--sdm-primary) 0%, var(--sdm-light-plum) 100%);
    color: var(--sdm-white) !important;
    padding: 60px 40px;
    margin: -30px -40px 40px -40px;
    text-align: center;
    font-size: 2.2rem;
    border-radius: 0;
    position: relative;
}
.page-template-default .entry-content > h2:first-of-type::after {
    content: '';
    display: block;
    width: 60px;
    height: 3px;
    background: var(--sdm-secondary);
    margin: 20px auto 0;
}

/* Service area page content wrapper */
.page-template-default .entry-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 30px 20px;
}

/* Service area page h3 sections as cards */
.page-template-default .entry-content h3 {
    background: var(--sdm-cream);
    padding: 20px 24px 16px;
    margin: 40px -24px 20px;
    border-radius: var(--sdm-radius) var(--sdm-radius) 0 0;
    border-bottom: 3px solid var(--sdm-secondary);
}

/* Service area CTA section */
.page-template-default .entry-content > p:last-of-type {
    text-align: center;
    padding-top: 20px;
}

/* Better spacing for service area list items */
.page-template-default .entry-content ul {
    background: var(--sdm-offwhite);
    padding: 20px 20px 20px 24px;
    border-radius: 0 0 var(--sdm-radius) var(--sdm-radius);
    margin-top: 0;
}


/* ===== NEW ILLUSTRATED LOGO SIZING ===== */
.ast-site-identity .site-logo-img img,
.ast-site-identity .custom-logo-link img,
.site-header .custom-logo-link img {
    max-height: 70px !important;
    width: auto !important;
    object-fit: contain !important;
}

/* Hide site title text since logo has text */
.ast-site-identity .site-title,
.ast-site-identity .ast-site-title-wrap .site-title {
    display: none !important;
}

/* Hide author on blog posts */
.entry-meta .posted-by,
.entry-meta .byline,
.ast-blog-single-element .posted-by,
.ast-blog-single-element-author,
.ast-single-post .entry-meta .posted-by,
.ast-single-post .entry-meta .byline,
.blog .entry-meta .posted-by,
.blog .entry-meta .byline,
.ast-author-box,
span.posted-by {
    display: none !important;
}


/* ===== CLICKABLE SERVICE CARDS ===== */
.elementor-widget-icon-box {
    cursor: pointer;
    transition: var(--sdm-transition);
}
.elementor-widget-icon-box:hover {
    transform: translateY(-5px);
    box-shadow: var(--sdm-shadow-hover);
}


/* ===== FULL SITE SWEEP - MODERN REFRESH ===== */

/* --- Blog Archive Grid Improvements --- */
.ast-separate-container .ast-article-post {
    border: none !important;
    box-shadow: var(--sdm-shadow) !important;
    border-radius: var(--sdm-radius) !important;
    overflow: hidden;
    transition: var(--sdm-transition) !important;
    margin-bottom: 30px !important;
}
.ast-separate-container .ast-article-post:hover {
    transform: translateY(-4px);
    box-shadow: var(--sdm-shadow-hover) !important;
}

/* Blog post featured image in archive */
.ast-article-post .post-thumb-img-content,
.ast-article-post .ast-blog-featured-section {
    border-radius: var(--sdm-radius) var(--sdm-radius) 0 0;
    overflow: hidden;
}
.ast-article-post .post-thumb-img-content img {
    transition: transform 0.5s ease;
}
.ast-article-post:hover .post-thumb-img-content img {
    transform: scale(1.05);
}

/* Blog category badges */
.ast-article-post .cat-links a,
.entry-meta .cat-links a {
    background: var(--sdm-secondary);
    color: var(--sdm-white) !important;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none !important;
    display: inline-block;
    margin: 2px;
}
.ast-article-post .cat-links a:hover {
    background: var(--sdm-primary);
}

/* Hide date on blog archive for cleaner look */
.blog .entry-meta .posted-on {
    display: none !important;
}

/* --- Contact Form Styling --- */
.fluentform .ff-el-input--label label {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    color: var(--sdm-charcoal);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.fluentform input[type="text"],
.fluentform input[type="email"],
.fluentform input[type="tel"],
.fluentform textarea {
    border: 2px solid #e0d8d0 !important;
    border-radius: var(--sdm-radius) !important;
    padding: 12px 16px !important;
    font-size: 15px !important;
    transition: var(--sdm-transition) !important;
    background: var(--sdm-offwhite) !important;
}
.fluentform input:focus,
.fluentform textarea:focus {
    border-color: var(--sdm-secondary) !important;
    box-shadow: 0 0 0 3px rgba(200, 150, 62, 0.15) !important;
    outline: none !important;
}
.fluentform .ff_submit_btn_wrapper button,
.fluentform button[type="submit"] {
    background: var(--sdm-secondary) !important;
    color: var(--sdm-white) !important;
    border: none !important;
    border-radius: var(--sdm-radius) !important;
    padding: 14px 40px !important;
    font-family: 'Inter', sans-serif !important;
    font-weight: 600 !important;
    font-size: 14px !important;
    text-transform: uppercase !important;
    letter-spacing: 1.5px !important;
    cursor: pointer !important;
    transition: var(--sdm-transition) !important;
}
.fluentform .ff_submit_btn_wrapper button:hover,
.fluentform button[type="submit"]:hover {
    background: var(--sdm-primary) !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(74, 32, 64, 0.3) !important;
}

/* --- Service Pages Styling --- */
.page-template-default .entry-content h1,
.page-template-default .entry-content h2 {
    font-family: 'Playfair Display', serif;
    color: var(--sdm-primary);
}
.page-template-default .entry-content h2 {
    position: relative;
    padding-bottom: 15px;
    margin-bottom: 25px;
}
.page-template-default .entry-content h2::after {
    content: '';
    display: block;
    width: 50px;
    height: 3px;
    background: var(--sdm-secondary);
    margin-top: 12px;
}

/* --- Modern Button Enhancements --- */
.elementor-button {
    transition: var(--sdm-transition) !important;
    border-radius: var(--sdm-radius) !important;
}
.elementor-button:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 20px rgba(0,0,0,0.15) !important;
}

/* --- Footer Modernization --- */
.site-footer {
    font-family: 'Inter', sans-serif;
}
.site-footer a:hover {
    color: var(--sdm-secondary) !important;
    transition: var(--sdm-transition);
}

/* --- Smooth Scroll --- */
html {
    scroll-behavior: smooth;
}

/* --- Single Blog Post Improvements --- */
.ast-single-post .entry-content {
    font-size: 17px;
    line-height: 1.8;
    color: var(--sdm-text);
}
.ast-single-post .entry-content p {
    margin-bottom: 1.5em;
}
.ast-single-post .entry-content img {
    border-radius: var(--sdm-radius);
    box-shadow: var(--sdm-shadow);
    margin: 20px 0;
}
.ast-single-post .entry-content h2 {
    font-family: 'Playfair Display', serif;
    color: var(--sdm-primary);
    margin-top: 2em;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--sdm-cream);
}
.ast-single-post .entry-content h3 {
    font-family: 'Playfair Display', serif;
    color: var(--sdm-light-plum);
}

/* --- Related Posts Section --- */
.ast-related-posts-wrapper {
    background: var(--sdm-cream) !important;
    padding: 40px !important;
    border-radius: var(--sdm-radius) !important;
    margin-top: 40px !important;
}

/* --- Scroll to Top Button --- */
#ast-scroll-top {
    background: var(--sdm-secondary) !important;
    color: var(--sdm-white) !important;
    border-radius: 50% !important;
    width: 45px !important;
    height: 45px !important;
    box-shadow: var(--sdm-shadow) !important;
    transition: var(--sdm-transition) !important;
}
#ast-scroll-top:hover {
    background: var(--sdm-primary) !important;
    transform: translateY(-3px);
}

/* --- Navigation Improvements --- */
.main-header-menu > .menu-item > a {
    transition: var(--sdm-transition) !important;
    position: relative;
}
.main-header-menu > .menu-item > a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--sdm-secondary);
    transition: var(--sdm-transition);
    transform: translateX(-50%);
}
.main-header-menu > .menu-item > a:hover::after,
.main-header-menu > .menu-item.current-menu-item > a::after {
    width: 80%;
}

/* --- Logo Sizing Refinement --- */
.ast-site-identity .site-logo-img img,
.ast-site-identity .custom-logo-link img,
.site-header .custom-logo-link img {
    max-height: 75px !important;
    width: auto !important;
    object-fit: contain !important;
    transition: var(--sdm-transition);
}

/* --- Service Card Hover Refinement --- */
.elementor-widget-icon-box {
    background: var(--sdm-white);
    border-radius: var(--sdm-radius) !important;
    padding: 10px;
}
.elementor-widget-icon-box .elementor-icon {
    transition: var(--sdm-transition);
}
.elementor-widget-icon-box:hover .elementor-icon {
    transform: scale(1.1);
}

/* --- Page Header Consistency --- */
.ast-archive-description {
    background: var(--sdm-primary) !important;
    padding: 60px 20px !important;
    text-align: center;
}
.ast-archive-description .page-title {
    font-family: 'Playfair Display', serif !important;
    color: var(--sdm-white) !important;
}


/* --- Hide date/meta completely on blog archive --- */
.blog .entry-meta,
.blog .ast-blog-single-element .posted-on,
.blog .ast-blog-single-element-date,
.ast-separate-container .entry-meta {
    display: none !important;
}

/* --- Hide date on single posts too --- */
.ast-single-post .entry-meta .posted-on {
    display: none !important;
}

/* --- Service Sub-Pages Styling --- */
.page-template-default .entry-content {
    font-size: 16px;
    line-height: 1.75;
}
.page-template-default .entry-content strong {
    color: var(--sdm-primary);
}

/* --- Better Blog Card Read More --- */
.ast-article-post .read-more a {
    color: var(--sdm-secondary) !important;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 1px;
    transition: var(--sdm-transition);
}
.ast-article-post .read-more a:hover {
    color: var(--sdm-primary) !important;
}

/* --- Services Dropdown Menu Styling --- */
.main-header-menu .sub-menu {
    background: var(--sdm-white) !important;
    border-radius: 0 0 var(--sdm-radius) var(--sdm-radius) !important;
    box-shadow: var(--sdm-shadow-hover) !important;
    border-top: 3px solid var(--sdm-secondary) !important;
}
.main-header-menu .sub-menu a {
    transition: var(--sdm-transition) !important;
    padding: 10px 20px !important;
}
.main-header-menu .sub-menu a:hover {
    background: var(--sdm-cream) !important;
    color: var(--sdm-primary) !important;
}


/* ===== FOOTER FIXES - DARK BACKGROUND HEADERS ===== */
/* Make footer widget titles (Quick Links, Serving East Idaho) visible on dark background */
.site-footer .widget-title,
.site-footer h2,
.site-footer h3,
.site-footer h4,
.site-footer .elementor-widget-heading .elementor-heading-title,
footer .widget-title,
footer h2,
footer h3,
footer h4,
.ast-footer-overlay .widget-title,
.ast-footer-overlay h2,
.ast-footer-overlay h3,
.ast-footer-overlay h4,
.footer-adv .widget-title,
.footer-adv h2,
.footer-adv h3,
.footer-adv h4,
.site-footer-above-section-1 .widget-title,
.site-footer-above-section-2 .widget-title,
.site-footer-primary-section-1 .widget-title,
.site-footer-primary-section-2 .widget-title,
.site-footer-primary-section-3 .widget-title,
.ast-builder-footer-grid-columns .widget-title,
.site-below-footer-wrap .widget-title,
.site-primary-footer-wrap .widget-title,
.site-above-footer-wrap .widget-title,
.elementor-location-footer .elementor-heading-title,
.site-footer .elementor-heading-title {
    color: #F5F0E8 !important;
    font-family: 'Playfair Display', serif !important;
    font-weight: 600 !important;
    letter-spacing: 0.5px !important;
}

/* Footer logo sizing */
.site-footer .custom-logo,
.site-footer img.custom-logo,
footer .custom-logo,
.ast-footer-overlay .custom-logo {
    max-width: 200px !important;
    height: auto !important;
}

/* Fix blog featured images stretching */
.ast-article-post .post-thumb img,
.ast-article-post .ast-blog-featured-section img,
.ast-archive-post .post-thumb img,
.ast-archive-post .ast-blog-featured-section img,
article .post-thumb img,
.blog .post-thumb img,
.archive .post-thumb img {
    width: 100% !important;
    height: 250px !important;
    object-fit: cover !important;
    object-position: center !important;
    border-radius: var(--sdm-radius) var(--sdm-radius) 0 0 !important;
}

/* Service page hero sections */
.service-page-hero {
    background: linear-gradient(135deg, var(--sdm-primary), var(--sdm-light-plum)) !important;
    color: white !important;
    padding: 60px 30px !important;
    text-align: center !important;
    border-radius: 0 !important;
    margin: -20px -20px 30px -20px !important;
}

/* Gallery page grid */
.gallery-grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 15px !important;
}
.gallery-grid img {
    width: 100% !important;
    height: 250px !important;
    object-fit: cover !important;
    border-radius: var(--sdm-radius) !important;
    transition: var(--sdm-transition) !important;
}
.gallery-grid img:hover {
    transform: scale(1.03) !important;
    box-shadow: var(--sdm-shadow-hover) !important;
}

/* Ensure all text on dark backgrounds is light */
.elementor-section[data-settings*="background_color"] .elementor-heading-title,
.elementor-section-wrap .elementor-section .elementor-widget-heading .elementor-heading-title {
    /* Only override when parent has dark bg - handled by specificity */
}

/* Footer link improvements */
.site-footer a,
footer a,
.ast-footer-overlay a {
    transition: color 0.3s ease !important;
}
.site-footer a:hover,
footer a:hover,
.ast-footer-overlay a:hover {
    color: var(--sdm-secondary) !important;
}


/* ===== FOOTER LOGO SWAP - Replace old logo with new illustrated logo ===== */
img.footer-logo[src*="logo-header-retina25"] {
    content: url('https://simplydeliciousmeals4you.com/wp-content/uploads/2026/04/logo_transparent.png') !important;
    max-width: 220px !important;
    height: auto !important;
    object-fit: contain !important;
}

/* Also handle via visibility/display swap approach for broader browser support */
.elementor-widget-image img[src*="logo-header-retina25"],
img[src*="logo-header-retina25"] {
    content: url('https://simplydeliciousmeals4you.com/wp-content/uploads/2026/04/logo_transparent.png') !important;
    max-width: 220px !important;
    height: auto !important;
}


/* ===== FOOTER LOGO SWAP ===== */
/* Hide old logo in Elementor footer and replace with new */
.footer-inner .footer-col img[src*="logo-header-retina"],
.footer-inner .footer-col img[src*="logo-header"] {
    content: url('https://simplydeliciousmeals4you.com/wp-content/uploads/2026/04/logo_transparent.png') !important;
    max-width: 200px !important;
    height: auto !important;
    object-fit: contain !important;
}

/* Also handle the Astra footer widget logo - make it smaller */
.site-footer .site-logo-img .custom-logo {
    max-width: 150px !important;
    height: auto !important;
}

/* ===== FOOTER HEADER COLORS (reinforced) ===== */
.footer-inner h4,
.footer-inner .footer-col h4,
.site-footer h4,
.site-footer .widget-title,
footer h4,
.footer-col h4 {
    color: #F5F0E8 !important;
    font-family: 'Playfair Display', serif !important;
}

/* Footer links styling */
.footer-inner a,
.footer-col a {
    color: #c8963e !important;
    transition: color 0.3s ease !important;
}
.footer-inner a:hover,
.footer-col a:hover {
    color: #e8c87a !important;
}


/* ===== MOBILE OPTIMIZATION - COMPREHENSIVE ===== */

/* --- Tablet Breakpoint (max-width: 768px) --- */
@media (max-width: 768px) {
    /* Header logo sizing */
    .ast-site-identity .custom-logo,
    .site-logo-img .custom-logo {
        max-width: 60px !important;
        height: auto !important;
    }
    
    /* Navigation spacing */
    .main-header-bar {
        padding: 5px 10px !important;
    }
    
    /* Hero section typography */
    .elementor-heading-title {
        font-size: 32px !important;
        line-height: 1.2 !important;
    }
    
    h1.elementor-heading-title,
    h1 {
        font-size: 36px !important;
    }
    
    h2.elementor-heading-title,
    h2 {
        font-size: 26px !important;
    }
    
    h3.elementor-heading-title,
    h3 {
        font-size: 20px !important;
    }
    
    /* Service cards - 2 column on tablet */
    .elementor-section .elementor-container {
        flex-wrap: wrap !important;
    }
    
    .elementor-col-25 {
        width: 50% !important;
    }
    
    /* CTA buttons full width */
    .elementor-button-wrapper {
        text-align: center !important;
    }
    
    .elementor-button {
        min-width: 200px !important;
        padding: 12px 24px !important;
    }
    
    /* Testimonial section */
    blockquote {
        font-size: 16px !important;
        padding: 15px !important;
    }
    
    /* Footer columns stack */
    .footer-inner .footer-col {
        width: 100% !important;
        margin-bottom: 20px !important;
    }
    
    /* Menu page tabs - horizontal scroll */
    .sdm-menu-tabs {
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch !important;
        flex-wrap: nowrap !important;
        justify-content: flex-start !important;
        padding-bottom: 10px !important;
        gap: 8px !important;
    }
    
    .sdm-menu-tabs button {
        flex-shrink: 0 !important;
        font-size: 13px !important;
        padding: 8px 16px !important;
        white-space: nowrap !important;
    }
    
    /* Menu page items - single column */
    .sdm-menu-grid {
        grid-template-columns: 1fr !important;
        gap: 16px !important;
    }
    
    .sdm-menu-hero h1 {
        font-size: 32px !important;
    }
    
    .sdm-category-title {
        font-size: 28px !important;
    }
    
    /* Gallery grid - 2 columns on tablet */
    .sdm-gallery-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 16px !important;
        padding: 0 16px !important;
    }
    
    .sdm-gallery-hero h1 {
        font-size: 32px !important;
    }
    
    /* Service sub-pages */
    .sdm-service-grid {
        grid-template-columns: 1fr !important;
    }
    
    .sdm-service-hero h1 {
        font-size: 32px !important;
    }
    
    /* Blog archive grid */
    .ast-archive-post {
        width: 100% !important;
    }
    
    /* Contact form */
    .fluentform .ff-el-group {
        margin-bottom: 12px !important;
    }
    
    /* Padding adjustments */
    .elementor-section {
        padding-left: 15px !important;
        padding-right: 15px !important;
    }
    
    /* Footer logo */
    img.footer-logo {
        max-width: 150px !important;
    }
}

/* --- Mobile Breakpoint (max-width: 480px) --- */
@media (max-width: 480px) {
    /* Header logo even smaller */
    .ast-site-identity .custom-logo,
    .site-logo-img .custom-logo {
        max-width: 50px !important;
        height: auto !important;
    }
    
    /* Typography - mobile sizes */
    h1, h1.elementor-heading-title {
        font-size: 28px !important;
        line-height: 1.2 !important;
    }
    
    h2, h2.elementor-heading-title {
        font-size: 22px !important;
    }
    
    h3, h3.elementor-heading-title {
        font-size: 18px !important;
    }
    
    body, p {
        font-size: 15px !important;
        line-height: 1.6 !important;
    }
    
    /* Service cards - single column */
    .elementor-col-25,
    .elementor-col-33,
    .elementor-col-50 {
        width: 100% !important;
    }
    
    /* CTA buttons - full width */
    .elementor-button-wrapper .elementor-button {
        width: 100% !important;
        display: block !important;
        text-align: center !important;
        padding: 14px 20px !important;
        font-size: 15px !important;
    }
    
    /* Hero section padding */
    .elementor-section.elementor-section-height-full {
        min-height: 60vh !important;
    }
    
    /* Menu page */
    .sdm-menu-container {
        padding: 0 10px !important;
    }
    
    .sdm-menu-tabs {
        gap: 6px !important;
    }
    
    .sdm-menu-tabs button {
        font-size: 12px !important;
        padding: 6px 12px !important;
    }
    
    .sdm-menu-item h4 {
        font-size: 16px !important;
    }
    
    .sdm-menu-hero {
        padding: 40px 15px !important;
    }
    
    .sdm-menu-hero h1 {
        font-size: 26px !important;
    }
    
    .sdm-category-title {
        font-size: 24px !important;
    }
    
    /* Gallery - single column */
    .sdm-gallery-grid {
        grid-template-columns: 1fr !important;
        gap: 20px !important;
        padding: 0 15px !important;
    }
    
    .sdm-gallery-hero {
        padding: 40px 15px !important;
    }
    
    .sdm-gallery-hero h1 {
        font-size: 26px !important;
    }
    
    /* Service sub-pages */
    .sdm-service-hero {
        padding: 40px 15px !important;
    }
    
    .sdm-service-hero h1 {
        font-size: 26px !important;
    }
    
    .sdm-service-card {
        padding: 20px !important;
    }
    
    /* Blog posts */
    .entry-title {
        font-size: 20px !important;
    }
    
    .entry-content {
        padding: 0 10px !important;
    }
    
    /* Testimonial */
    blockquote {
        font-size: 15px !important;
        margin: 10px !important;
        padding: 15px !important;
    }
    
    /* Footer */
    .site-footer {
        padding: 20px 15px !important;
    }
    
    .footer-inner {
        padding: 0 10px !important;
    }
    
    img.footer-logo {
        max-width: 120px !important;
    }
    
    .site-footer h4,
    .site-footer .widget-title {
        font-size: 16px !important;
        margin-bottom: 10px !important;
    }
    
    /* Touch-friendly tap targets */
    a, button, .elementor-button,
    .sdm-menu-tabs button {
        min-height: 44px;
        min-width: 44px;
    }
    
    /* Prevent horizontal overflow */
    body {
        overflow-x: hidden !important;
    }
    
    img {
        max-width: 100% !important;
        height: auto !important;
    }
    
    /* Spacing adjustments */
    .elementor-section {
        padding-top: 30px !important;
        padding-bottom: 30px !important;
    }
    
    /* Menu option tags smaller */
    .sdm-option-tag {
        font-size: 10px !important;
        padding: 2px 6px !important;
    }
    
    .sdm-popular-badge {
        font-size: 9px !important;
        padding: 2px 8px !important;
    }
}

/* --- Small Mobile (max-width: 360px) --- */
@media (max-width: 360px) {
    h1, h1.elementor-heading-title {
        font-size: 24px !important;
    }
    
    h2, h2.elementor-heading-title {
        font-size: 20px !important;
    }
    
    .sdm-menu-hero h1,
    .sdm-gallery-hero h1,
    .sdm-service-hero h1 {
        font-size: 22px !important;
    }
}

/* --- Smooth scrolling for mobile --- */
@media (max-width: 768px) {
    html {
        scroll-behavior: smooth;
    }
    
    /* Improve readability on mobile */
    .elementor-text-editor p,
    .elementor-widget-text-editor p {
        font-size: 15px !important;
        line-height: 1.7 !important;
    }
    
    /* Fix any horizontal overflow issues */
    .elementor-section-wrap,
    .elementor-section,
    .elementor-container,
    .site-content {
        max-width: 100vw !important;
        overflow-x: hidden !important;
    }
}


/* ===== HERO BANNER STYLES (Location Pages) ===== */
.sdm-hero-banner {
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
}

.sdm-hero-overlay {
    position: relative;
    width: 100%;
    text-align: center;
    padding: 80px 20px;
    background: linear-gradient(135deg, rgba(74, 32, 64, 0.85) 0%, rgba(45, 27, 61, 0.85) 50%, rgba(26, 42, 26, 0.85) 100%);
}

.sdm-hero-title {
    font-family: 'Playfair Display', serif !important;
    color: #f5f0e8 !important;
    font-size: clamp(2rem, 5vw, 3.2rem) !important;
    margin-bottom: 15px !important;
    font-weight: 700 !important;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
}

.sdm-hero-subtitle {
    color: #d4c5a9 !important;
    font-size: clamp(1rem, 2vw, 1.2rem) !important;
    max-width: 700px;
    margin: 0 auto 20px auto !important;
    font-family: 'Inter', sans-serif !important;
}

.sdm-hero-cta {
    display: inline-block !important;
    background: #6b8c42 !important;
    color: white !important;
    padding: 14px 36px !important;
    border-radius: 30px !important;
    text-decoration: none !important;
    font-weight: 600 !important;
    font-size: 0.9rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    transition: all 0.3s ease !important;
    box-shadow: 0 4px 15px rgba(107, 140, 66, 0.3);
}

.sdm-hero-cta:hover {
    background: #5a7a36 !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 20px rgba(107, 140, 66, 0.4) !important;
}

/* Hide awkward "SERVICE AREAS" and "OUR SERVICES" h6 labels on location pages */
.entry-content h6.wp-block-heading {
    display: none !important;
}

/* ===== VENUE PAGE RESPONSIVE FIXES ===== */
@media (max-width: 768px) {
    .sdm-hero-banner {
        min-height: 220px;
    }
    .sdm-hero-overlay {
        padding: 50px 15px;
    }
    /* Fix venue page 2-column grids on mobile */
    div[style*="grid-template-columns: 1fr 1fr"] {
        grid-template-columns: 1fr !important;
    }
    div[style*="grid-template-columns: repeat(auto-fill"] {
        grid-template-columns: 1fr !important;
    }
}

@media (max-width: 480px) {
    .sdm-hero-banner {
        min-height: 180px;
    }
    .sdm-hero-overlay {
        padding: 40px 10px;
    }
}


/* ===== FIX: INTERIOR PAGE BANNER TEXT READABILITY ===== */
/* Fix hero banner title color - override the general h1/h2 color rules */
.page-template-default .entry-content .sdm-hero-banner h1.sdm-hero-title,
.page-template-default .entry-content h1.sdm-hero-title,
.sdm-hero-overlay h1.sdm-hero-title,
body .sdm-hero-title {
    color: #f5f0e8 !important;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5) !important;
}

/* Fix hero subtitle color */
.page-template-default .entry-content .sdm-hero-subtitle,
body .sdm-hero-subtitle {
    color: #d4c5a9 !important;
}

/* Fix first h2 section banner text color on service area pages */
.page-template-default .entry-content > h2.wp-block-heading:first-of-type,
.page-template-default .entry-content > h2:first-of-type,
.page-child .entry-content > h2:first-of-type {
    color: #FFFFFF !important;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3) !important;
}

/* ===== FIX: FOOTER LOGO VISIBILITY ===== */
.sdm-custom-footer .footer-logo,
footer .footer-logo,
img.footer-logo {
    filter: none;
    opacity: 0.9;
}


/* ===== FIX: VENUE PAGE - HIDE EMPTY BLOCKS & FIX CARD STYLING ===== */
/* Hide empty P tags in venue grid that contain empty links */
.entry-content div[style*="grid"] > p {
    display: none !important;
}

/* Restore proper styling for venue card links in the grid */
.entry-content div[style*="grid"] > a[style*="background"] {
    background: white !important;
    padding: 25px !important;
    display: block !important;
    border-radius: 12px !important;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08) !important;
    transition: transform 0.2s, box-shadow 0.2s !important;
    text-decoration: none !important;
}

.entry-content div[style*="grid"] > a[style*="background"]:hover {
    transform: translateY(-3px) !important;
    box-shadow: 0 8px 25px rgba(0,0,0,0.12) !important;
}

.entry-content div[style*="grid"] > a[style*="background"] h3 {
    color: var(--sdm-primary, #4a1a2e) !important;
    font-size: 20px !important;
    margin-bottom: 8px !important;
}

.entry-content div[style*="grid"] > a[style*="background"] p {
    color: #666 !important;
    font-size: 14px !important;
}

/* ===== FIX: BANNER TEXT READABILITY ON DARK BACKGROUNDS ===== */
/* Uses body.page-template-default for higher specificity to override h2:first-of-type rule */
body.page-template-default .entry-content div[style*="linear-gradient"] h1,
body.page-template-default .entry-content div[style*="linear-gradient"] h2,
body.page-template-default .entry-content div[style*="linear-gradient"] h3,
body.page-template-default .entry-content div[style*="#4a1a2e"] h1,
body.page-template-default .entry-content div[style*="#4a1a2e"] h2,
body.page-template-default .entry-content div[style*="#4a1a2e"] h3,
body.page-template-default .entry-content div[style*="#2d1b3d"] h1,
body.page-template-default .entry-content div[style*="#2d1b3d"] h2,
body.page-template-default .entry-content div[style*="#2d1b3d"] h3,
body.page-template-default .entry-content div[style*="#1a2a1a"] h1,
body.page-template-default .entry-content div[style*="#1a2a1a"] h2,
body.page-template-default .entry-content div[style*="#1a2a1a"] h3 {
    color: #f5f0e8 !important;
    text-shadow: 0 2px 4px rgba(0,0,0,0.4) !important;
}

/* Paragraphs inside dark gradient banners */
body.page-template-default .entry-content div[style*="linear-gradient"] p {
    color: #d4c5a9 !important;
}

/* The sdm-hero-title class - high specificity */
body.page-template-default .entry-content .sdm-hero-banner h1.sdm-hero-title,
body.page-template-default .entry-content h1.sdm-hero-title,
body .sdm-hero-overlay h1 {
    color: #f5f0e8 !important;
    text-shadow: 0 2px 4px rgba(0,0,0,0.4) !important;
}

/* ===== FIX: FOOTER LOGO ===== */
/* Show original colorful logo without filter - the complex illustration doesn't invert cleanly */
.sdm-custom-footer .footer-logo,
footer .footer-logo,
img.footer-logo,
.sdm-custom-footer .footer-col:first-child img,
.sdm-custom-footer img[src*="logo"],
footer .footer-col img[src*="logo"] {
    filter: none !important;
    opacity: 1 !important;
}


/* === GALLERY PAGE HERO FIX === */
.sd-gallery-hero h1,
.sd-gallery-hero h2,
.sd-gallery-hero p,
body.page-template-default .entry-content .sd-gallery-hero h1,
body.page-template-default .entry-content .sd-gallery-hero h2 {
    color: #F5F0E8 !important;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
}</style><script>// Service Areas - Auto-link city names to their pages
document.addEventListener('DOMContentLoaded', function() {
    if (!window.location.pathname.includes('service-areas')) return;
    // Only run on the main service areas page, not child pages
    if (window.location.pathname !== '/service-areas/' && window.location.pathname !== '/service-areas') return;
    
    var cityMap = {
        'Idaho Falls': 'idaho-falls',
        'Ammon': 'ammon',
        'Blackfoot': 'blackfoot',
        'Pocatello': 'pocatello',
        'Rexburg': 'rexburg',
        'Shelley': 'shelley',
        'Iona': 'catering-in-iona',
        'Ucon': 'catering-in-ucon',
        'Firth': 'catering-in-firth',
        'Basalt': 'catering-in-basalt',
        'Rigby': 'catering-in-rigby',
        'Sugar City': 'catering-in-sugar-city',
        'St. Anthony': 'catering-in-st-anthony',
        'Ashton': 'catering-in-ashton',
        'Newdale': 'catering-in-newdale',
        'Teton': 'catering-in-teton',
        'Parker': 'catering-in-parker',
        'Driggs': 'catering-in-driggs',
        'Victor': 'catering-in-victor',
        'Tetonia': 'catering-in-tetonia',
        'Alta': 'catering-in-felt',
        'Chubbuck': 'catering-in-chubbuck',
        'American Falls': 'catering-in-american-falls',
        'Aberdeen': 'catering-in-aberdeen',
        'Inkom': 'catering-in-inkom',
        'Salmon': 'catering-in-salmon',
        'Challis': 'catering-in-challis',
        'Leadore': 'catering-in-leadore',
        'Arco': 'catering-in-arco',
        'Mud Lake': 'catering-in-mud-lake',
        'Terreton': 'catering-in-terreton',
        'Hamer': 'catering-in-hamer',
        'Roberts': 'catering-in-roberts',
        'Menan': 'catering-in-menan',
        'Lewisville': 'catering-in-lewisville',
        'Monteview': 'catering-in-monteview',
        'Atomic City': 'catering-in-atomic-city',
        'Dubois': 'catering-in-dubois',
        'Spencer': 'catering-in-spencer',
        'Ririe': 'catering-in-ririe',
        'Twin Falls': 'catering-in-twin-falls',
        'Jerome': 'catering-in-jerome',
        'Burley': 'catering-in-burley',
        'Rupert': 'catering-in-rupert',
        'Hailey': 'catering-in-hailey',
        'Ketchum': 'catering-in-ketchum',
        'Sun Valley': 'catering-in-sun-valley',
        'Bellevue': 'catering-in-bellevue',
        'Gooding': 'catering-in-gooding',
        'Shoshone': 'catering-in-shoshone',
        'North Fork': 'catering-in-north-fork',
        'Gibbonsville': 'catering-in-gibbonsville',
        'Stanley': 'catering-in-stanley',
        'Mackay': 'catering-in-mackay',
        'Lava Hot Springs': 'catering-in-lava-hot-springs'
    };
    
    var baseUrl = '/service-areas/';
    var content = document.querySelector('.entry-content') || document.querySelector('.site-content') || document.querySelector('.elementor');
    if (!content) return;
    
    var cities = Object.keys(cityMap).sort(function(a, b) { return b.length - a.length; });
    
    function walkTextNodes(node) {
        if (node.nodeType === 3) {
            var text = node.textContent;
            var parent = node.parentNode;
            if (parent.tagName === 'A' || parent.tagName === 'H1' || parent.tagName === 'H2' || parent.tagName === 'H3') return;
            for (var i = 0; i < cities.length; i++) {
                var city = cities[i];
                var idx = text.indexOf(city);
                if (idx !== -1) {
                    var before = document.createTextNode(text.substring(0, idx));
                    var link = document.createElement('a');
                    link.href = baseUrl + cityMap[city] + '/';
                    link.textContent = city;
                    link.style.color = '#4A2040';
                    link.style.textDecoration = 'underline';
                    link.style.textDecorationColor = '#C9A96E';
                    var after = document.createTextNode(text.substring(idx + city.length));
                    parent.insertBefore(before, node);
                    parent.insertBefore(link, node);
                    parent.insertBefore(after, node);
                    parent.removeChild(node);
                    if (after.textContent.length > 0) walkTextNodes(after);
                    break;
                }
            }
        } else if (node.nodeType === 1 && node.tagName !== 'A' && node.tagName !== 'SCRIPT' && node.tagName !== 'STYLE') {
            var children = Array.prototype.slice.call(node.childNodes);
            for (var j = 0; j < children.length; j++) walkTextNodes(children[j]);
        }
    }
    walkTextNodes(content);
});

// Menu Page Filter Bar
document.addEventListener('DOMContentLoaded', function() {
    if (!document.body.classList.contains('page-id-919')) return;
    var postContent = document.querySelector('.post-content') || document.querySelector('.entry-content');
    if (!postContent) return;
    var sections = postContent.querySelectorAll('.fusion-fullwidth');
    var categories = [];
    sections.forEach(function(section) {
        var h3 = section.querySelector('.fusion-title h3');
        if (h3 && h3.textContent.trim()) {
            categories.push({name: h3.textContent.trim(), section: section});
        }
    });
    if (categories.length === 0) return;
    var filterBar = document.createElement('div');
    filterBar.id = 'sdm-menu-filter-bar';
    filterBar.style.cssText = 'position:sticky;top:80px;z-index:100;background:#FDF8F0;padding:15px 20px;text-align:center;border-bottom:2px solid #C9A96E;margin-bottom:20px;';
    var allBtn = document.createElement('button');
    allBtn.textContent = 'All Menus';
    allBtn.className = 'sdm-filter-btn active';
    allBtn.onclick = function() { categories.forEach(function(c){c.section.style.display='';});document.querySelectorAll('.sdm-filter-btn').forEach(function(b){b.classList.remove('active');});this.classList.add('active'); };
    filterBar.appendChild(allBtn);
    categories.forEach(function(cat) {
        var btn = document.createElement('button');
        btn.textContent = cat.name;
        btn.className = 'sdm-filter-btn';
        btn.onclick = function() { categories.forEach(function(c){c.section.style.display='none';});cat.section.style.display='';document.querySelectorAll('.sdm-filter-btn').forEach(function(b){b.classList.remove('active');});this.classList.add('active'); };
        filterBar.appendChild(btn);
    });
    var firstSection = postContent.querySelector('.fusion-fullwidth, .fusion-container-anchor');
    if (firstSection) firstSection.parentNode.insertBefore(filterBar, firstSection);
});

// Menu Page - Add Popular badges and improve card styling
document.addEventListener('DOMContentLoaded', function() {
    if (!window.location.pathname.includes('our-menus')) return;
    
    // Popular items to highlight
    var popularItems = [
        'Charcuterie Boards', 'Grazing Table', 'Pinwheel Sandwiches',
        'Warm Chicken Ranch Dip', 'Teriyaki Meatballs', 'Caesar Salad',
        'Loaded Baked Potato Soup', 'Pulled Pork', 'Smoked Brisket',
        'Chicken Alfredo', 'Garlic Bread', 'Cheesecake'
    ];
    
    // Find all menu item headings and add Popular badges
    var headings = document.querySelectorAll('.fusion-fullwidth h3, .fusion-fullwidth h4, .elementor-widget-heading h3, .elementor-widget-heading h4');
    headings.forEach(function(h) {
        var text = h.textContent.trim();
        if (popularItems.some(function(item) { return text.toLowerCase().includes(item.toLowerCase()); })) {
            var badge = document.createElement('span');
            badge.className = 'sdm-popular-badge';
            badge.textContent = 'Popular';
            h.style.position = 'relative';
            h.style.display = 'flex';
            h.style.alignItems = 'center';
            h.style.gap = '10px';
            h.appendChild(badge);
        }
    });
    
    // Also check for text that contains menu item names in paragraphs/list items
    var allText = document.querySelectorAll('.fusion-fullwidth li, .fusion-fullwidth p strong, .elementor-widget-text-editor li, .elementor-widget-text-editor p strong');
    allText.forEach(function(el) {
        var text = el.textContent.trim();
        if (popularItems.some(function(item) { return text.toLowerCase() === item.toLowerCase() || text.toLowerCase().startsWith(item.toLowerCase()); })) {
            if (!el.querySelector('.sdm-popular-badge')) {
                var badge = document.createElement('span');
                badge.className = 'sdm-popular-badge';
                badge.textContent = 'Popular';
                el.style.position = 'relative';
                el.appendChild(badge);
            }
        }
    });
});


// ===== LOVABLE-STYLE CUSTOM FOOTER =====
document.addEventListener('DOMContentLoaded', function() {
    var footer = document.createElement('footer');
    footer.className = 'sdm-custom-footer';
    footer.innerHTML = '<div class="footer-inner">' +
        '<div class="footer-col">' +
            '<img src="/wp-content/uploads/2026/04/logo_transparent.png" alt="Simply Delicious Catering &amp; BBQ" class="footer-logo" style="max-width: 200px; height: auto; object-fit: contain;">' +
            '<p style="margin-top:12px;color:#b0b0b0;font-size:14px;line-height:1.7;">From rustic BBQ to elegant plated dinners, we bring exceptional food and service to every event across Eastern Idaho.</p>' +
            '<div style="margin-top:20px;">' +
                '<div class="footer-contact-item"><span style="color:#C8963E;margin-right:6px;">&#9742;</span><a href="tel:2088814292">(208) 881-4292</a></div>' +
                '<div class="footer-contact-item"><span style="color:#C8963E;margin-right:6px;">&#9993;</span><a href="mailto:simplydeliciousmeals4you@gmail.com">simplydeliciousmeals4you@gmail.com</a></div>' +
                '<div class="footer-contact-item"><span style="color:#C8963E;margin-right:6px;">&#9873;</span><span style="color:#b0b0b0;">Serving all of Eastern Idaho</span></div>' +
            '</div>' +
        '</div>' +
        '<div class="footer-col">' +
            '<h4>Quick Links</h4>' +
            '<ul>' +
                '<li><a href="/">Home</a></li>' +
                '<li><a href="/about-us/">About Us</a></li>' +
                '<li><a href="/our-menus/">Our Menus</a></li>' +
                '<li><a href="/services/">Services</a></li>' +
                '<li><a href="/service-areas/">Service Areas</a></li>' +
                '<li><a href="/contact/">Contact</a></li>' +
            '</ul>' +
        '</div>' +
        '<div class="footer-col">' +
            '<h4>Serving East Idaho</h4>' +
            '<ul>' +
                '<li><a href="/service-areas/idaho-falls/">Idaho Falls</a></li>' +
                '<li><a href="/service-areas/pocatello/">Pocatello</a></li>' +
                '<li><a href="/service-areas/rexburg/">Rexburg</a></li>' +
                '<li><a href="/service-areas/catering-in-driggs/">Driggs</a></li>' +
                '<li><a href="/service-areas/blackfoot/">Blackfoot</a></li>' +
                '<li><a href="/service-areas/ammon/">Ammon</a></li>' +
                '<li><a href="/service-areas/">View All Areas</a></li>' +
            '</ul>' +
        '</div>' +
        '<div class="footer-col">' +
            '<h4>Venues</h4>' +
            '<ul>' +
                '<li><a href="/venues/labelle-lake-rigby/">LaBelle Lake</a></li>' +
                '<li><a href="/venues/millhouse-rigby/">The Millhouse</a></li>' +
                '<li><a href="/venues/atrium-rexburg/">The Atrium</a></li>' +
                '<li><a href="/venues/red-barn-1st-idaho-falls/">Red Barn 1st</a></li>' +
                '<li><a href="/venues/the-waterfront-idaho-falls/">The Waterfront</a></li>' +
                '<li><a href="/venues/westbank-events-idaho-falls/">Westbank Events</a></li>' +
                '<li><a href="/venues/">View All Venues</a></li>' +
            '</ul>' +
        '</div>' +
    '</div>' +
    '<div class="footer-bottom">' +
        '<p>&copy; 2026 Simply Delicious Catering & BBQ. All rights reserved.</p>' +
    '</div>';
    document.body.appendChild(footer);
});

// ===== MENU PAGE - POPULAR BADGES =====
document.addEventListener('DOMContentLoaded', function() {
    if (!window.location.pathname.includes('our-menus')) return;
    
    var popularMenus = ['BBQ', 'Barbecue', 'Main Dishes', 'Desserts', 'Appetizers', 'Chicken'];
    
    var headings = document.querySelectorAll('h3');
    headings.forEach(function(h) {
        var text = h.textContent.trim();
        for (var i = 0; i < popularMenus.length; i++) {
            if (text.toLowerCase().includes(popularMenus[i].toLowerCase())) {
                var badge = document.createElement('span');
                badge.className = 'sdm-popular-badge';
                badge.textContent = 'Popular';
                badge.style.cssText = 'display:inline-block;background:#C8963E;color:#fff;font-size:11px;font-weight:600;padding:2px 10px;border-radius:12px;margin-left:12px;vertical-align:middle;font-family:Inter,sans-serif;letter-spacing:0.5px;';
                h.appendChild(badge);
                break;
            }
        }
    });
});
