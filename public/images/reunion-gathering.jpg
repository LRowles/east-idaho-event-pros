}

/* ===== DIVIDER STYLING ===== */
.elementor-divider-separator {
    border-color: #C8963E !important;
}

/* ===== ICON BOX STYLING ===== */
.elementor-icon {
    color: #C8963E !important;
    font-size: 2.5rem !important;
}

/* ===== CONTACT PAGE ===== */
.elementor-page-1150 .elementor-section:nth-child(2) {
